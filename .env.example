# Puerto en el que el servicio escucha en el host (docker-compose lo mapea)
APP_PORT=8000

# Rutas al artefacto del modelo dentro del contenedor.
# Normalmente NO hace falta tocarlas: ya vienen bien seteadas en
# docker-compose.yml. Solo se sobreescriben si mueves los artefactos
# a otro lugar dentro de la imagen.
MODEL_PATH=/srv/models/model.joblib
METADATA_PATH=/srv/models/metadata.json
